[
    %% Set hostname, database and admin_password in a private site config before enabling.
    {enabled, false},
    {site, mediarunner},
    {hostname, "mediarunner.example.com"},
    {dbschema, "mediarunner"},
    {environment, production},
    {title, "Media runner"},
    {mediarunner_workers, auto},
    {mediarunner_memory_per_worker, 4294967296},
    {mediarunner_cache_max_bytes, 1073741824},
    {mediarunner_cache_version, 1},
    {mediarunner_queue_limit, 100},
    {mediarunner_storage_limit, 1073741824},
    %% Trust authenticated callers, or restrict to a list of exact HTTPS endpoints.
    %% An empty list disables callbacks; endpoints cannot have a query or fragment.
    {mediarunner_callback_urls, any},
    {modules, [mediarunner, mod_base, mod_authentication, mod_acl_user_groups,
        mod_content_groups, mod_menu, mod_search,
        mod_oauth2, mod_admin, mod_admin_config, mod_admin_identity,
        mod_admin_modules, mod_wires, mod_mqtt, mod_translation,
        mod_logging, mod_cron, mod_ratelimit]}
].
